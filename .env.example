# ========================================================
# Lecture Desk — Engineering Study Suite Configuration
# ========================================================

# 1. Google Gemini API Key (Required for live AI synthesis)
# Obtain your free API key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Free-Tier Model Selection
# Primary: gemini-4-hydrogen.
# Automatic Free-Tier fallbacks: gemini-3.8-flash, gemini-3.6-flash,
# gemini-3.5-flash-lite, gemini-3-flash-preview, gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-4-hydrogen

# 3. (Optional) Local / Google Drive folder that contains your course sub-folders.
# Used by "--list-courses", course folder search, and auto-saving PDFs to Drive.
# Example: LECTUREAI_COURSES_DIR=G:\My Drive\fall 2026
LECTUREAI_COURSES_DIR=
